# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings → API Keys (and Data API for the URL).

# Safe in the browser: Row Level Security limits what these can do.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRET. Bypasses Row Level Security. Used only by `npm run seed`.
# Never give it a NEXT_PUBLIC_ name and never commit it.
SUPABASE_SECRET_KEY=sb_secret_...
